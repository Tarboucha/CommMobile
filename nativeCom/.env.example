# =============================================================================
# Mobile App Environment Variables
# Copy to .env and replace 192.168.0.140 with your machine's local IP
# Find it with: hostname -I | awk '{print $1}'
# =============================================================================

# All production services are fronted by nginx at api.comchefs.cloud,
# path-routed: /auth/* → auth-service, /api/* → kodo-api, /ws/* → socket-server.

# Auth service (login, register, logout, refresh, change-password)
EXPO_PUBLIC_AUTH_URL=http://192.168.0.140:3004
EXPO_PUBLIC_AUTH_URL_PROD=https://api.comchefs.cloud

# API (bookings, communities, profiles, offerings, etc.)
EXPO_PUBLIC_API_URL=http://192.168.0.140:3002
EXPO_PUBLIC_API_URL_PROD=https://api.comchefs.cloud

# Socket.io (real-time messages, notifications)
EXPO_PUBLIC_SOCKET_URL=http://192.168.0.140:3001
EXPO_PUBLIC_SOCKET_URL_PROD=https://api.comchefs.cloud

# Cloudflare R2 (file storage CDN) — set to your R2 custom domain
EXPO_PUBLIC_R2_PUBLIC_URL=https://cdn.comchefs.cloud

# Optional: Stripe
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional: Sentry
SENTRY_DSN=https://xxx@sentry.io/xxx
