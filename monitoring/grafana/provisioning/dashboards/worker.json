          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (exported_job, le) (rate(kodo_worker_job_duration_seconds_bucket[1h])))",
          "legendFormat": "{{exported_job}} p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (exported_job, le) (rate(kodo_worker_job_duration_seconds_bucket[1h])))",
          "legendFormat": "{{exported_job}} p99",
          "refId": "C"
        }
