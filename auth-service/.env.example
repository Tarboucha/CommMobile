# Auth service
DATABASE_URL=postgresql://kodo:password@postgres:5432/kodo
PORT=3004

# EC key pair (ES256) — generated on first run, copy from stdout into .env
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=

# SMTP (for email verification + password reset)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-api-key
SMTP_FROM=noreply@kodo.app

# App URL (used in email links)
APP_URL=https://kodo.app
