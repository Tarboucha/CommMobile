PORT=3001
HOSTNAME=0.0.0.0

# Direct PostgreSQL connection (bypasses RLS — for pg LISTEN + push token queries)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase JWT secret — for local JWT validation (no call to kodo-api)
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis — same instance as kodo-api
REDIS_URL=redis://redis:6379
