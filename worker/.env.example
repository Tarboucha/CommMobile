# Worker — picks up env from root .env via docker-compose
# This file documents what's needed; actual values live in /.env
DATABASE_URL=postgresql://kodo:password@postgres:5432/kodo

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kodo-assets

# Optional: run all jobs once on startup, then continue with the schedule.
# Useful for ad-hoc cleanup runs.
WORKER_RUN_ON_BOOT=false
