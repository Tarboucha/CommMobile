generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model addresses {
  id                    String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  profile_id            String                    @unique(map: "idx_addresses_one_default_per_profile", where: raw("((is_default = true) AND (deleted_at IS NULL))")) @db.Uuid
  address_type          address_type?             @default(home)
  label                 String?
  street_name           String
  street_number         String?
  apartment_unit        String?
  city                  String
  state                 String
  postal_code           String
  country               String?                   @default("Germany")
  latitude              Decimal                   @db.Decimal(10, 8)
  longitude             Decimal                   @db.Decimal(11, 8)
  location              Unsupported("geography")?
  delivery_instructions String?
  is_default            Boolean?                  @default(false)
  is_active             Boolean?                  @default(true)
  visibility            String?                   @default("private")
  created_at            DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?                 @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?                 @db.Timestamptz(6)
  profiles              profiles                  @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings              bookings[]
  communities           communities[]
  offerings             offerings[]
  snapshot_addresses    snapshot_addresses[]

  @@index([deleted_at], map: "idx_addresses_deleted_at", where: raw("(deleted_at IS NOT NULL)"))
  @@index([location], map: "idx_addresses_location", type: Gist)
  @@index([id], map: "idx_addresses_offering_pickup", where: raw("((visibility = 'offering_pickup'::text) AND (is_active = true) AND (deleted_at IS NULL))"))
  @@index([profile_id, is_default], map: "idx_addresses_profile_default", where: raw("(is_default = true)"))
  @@index([profile_id], map: "idx_addresses_profile_id")
  @@schema("public")
}

