  dtstart                    DateTime                     @db.Date
  dtend                      DateTime?                    @db.Date
  rrule                      String
  start_time                 DateTime                     @db.Time(6)
  end_time                   DateTime                     @db.Time(6)
  slots_available            Int                          @default(10)
  slot_unit                  String?
  slot_label                 String?
  is_active                  Boolean?                     @default(true)
  loan_duration_days         Int                          @default(1)
  loan_max_duration_days     Int?
  slot_duration_minutes      Int?
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  offerings                  offerings                    @relation(fields: [offering_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  booking_items              booking_items[]
  booking_schedule_snapshots booking_schedule_snapshots[]
  schedule_exceptions        schedule_exceptions[]
  schedule_instances         schedule_instances[]

  @@index([offering_id, dtstart, dtend], map: "idx_availability_schedules_date_range", where: raw("(is_active = true)"))
  @@index([offering_id], map: "idx_availability_schedules_offering", where: raw("(is_active = true)"))
  @@schema("public")
}

