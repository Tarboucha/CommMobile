# =============================================================================
# Shared environment variables — loaded by ALL services via docker-compose
# Copy to .env and fill in values
# =============================================================================

# PostgreSQL — direct connection (used by Prisma, PgNotifyManager, auth-service)
DATABASE_URL=postgresql://kodo:your-password@postgres:5432/kodo
POSTGRES_PASSWORD=

# Auth service — ES256 JWT key pair (generated on first run of auth-service)
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=

# SMTP (for email verification + password reset)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-api-key
SMTP_FROM=noreply@kodo.app

# App URL (used in email links)
APP_URL=https://kodo.app

# Cloudflare R2 — S3-compatible file storage
R2_ENDPOINT=https://9e5bcd088da8d4275bee280588278ff6.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kodo-assets
R2_PUBLIC_URL=https://cdn.kodo.app
