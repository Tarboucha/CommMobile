# =============================================================================
# Root .env — loaded by ALL services via docker-compose env_file
# Copy to .env and fill in values. Never commit the real .env.
#
# Values marked [auto] are set by docker-compose environment: blocks
# and don't need to be in this file unless you want to override.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Used by: kodo-api (Prisma), auth-service, socket-server (PgNotify), worker
POSTGRES_PASSWORD=                          # generate with: openssl rand -base64 32
DATABASE_URL=postgresql://kodo:YOUR_POSTGRES_PASSWORD_HERE@postgres:5432/kodo

# ─── Auth Service (JWT key pair) ─────────────────────────────────────────────
# Used by: auth-service (sign tokens), kodo-api + socket-server (verify via JWKS)
# Generated on first run of auth-service — copy from stdout into here, then restart
AUTH_PRIVATE_KEY=                            # '{"kty":"EC","x":"...","y":"...","crv":"P-256","d":"..."}'
AUTH_PUBLIC_KEY=                             # '{"kty":"EC","x":"...","y":"...","crv":"P-256"}'

# ─── Google Sign-In ──────────────────────────────────────────────────────────
# Used by: auth-service (verifies the `aud` claim on incoming Google ID tokens).
# Value is the Web OAuth Client ID from Google Cloud Console — the *Web* one,
# not the Android one. The mobile app also references this same client ID.
GOOGLE_WEB_CLIENT_ID=                       # xxxxxxxxxxxx-xxxxx.apps.googleusercontent.com

# ─── Email (Resend) — verification + password reset ─────────────────────────
# Used by: auth-service. Sign in at resend.com, verify comchefs.cloud,
# generate a sending-access key, put it here.
RESEND_API_KEY=                             # re_xxxxxxxxxxxx
MAIL_FROM=KoDo <noreply@comchefs.cloud>
# Cooldown between /auth/resend-verification sends per user (seconds).
# Default 300s (5min). Shorter = more support-friendly, longer = less abuse.
VERIFICATION_RESEND_COOLDOWN_SECONDS=300

# ─── App URL ────────────────────────────────────────────────────────────────
# Used by: auth-service (email links point here)
APP_URL=https://comchefs.cloud

# ─── Cloudflare R2 (S3-compatible file storage) ─────────────────────────────
# Used by: kodo-api (presign uploads, delete objects), worker (orphan sweep)
R2_ENDPOINT=https://9e5bcd088da8d4275bee280588278ff6.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=                           # from R2 API Token
R2_SECRET_ACCESS_KEY=                       # from R2 API Token
R2_BUCKET=kodo-avatars                      # your R2 bucket name
R2_PUBLIC_URL=https://pub-5e5e43d5135e47ada2dbd04de138e349.r2.dev

# ─── Set by docker-compose (no need to fill here) ───────────────────────────
# AUTH_SERVICE_URL=http://auth-service:3004  [auto] kodo-api + socket-server
# REDIS_URL=redis://redis:6379              [auto] socket-server
# PORT=3002/3004/3001                       [auto] per service
# HOSTNAME=0.0.0.0                          [auto] kodo-api
# NODE_ENV=production                       [auto] all services
# WORKER_RUN_ON_BOOT=false                  [auto] worker (set true for one-off runs)

# ─── Observability (docker-compose.monitoring.yml) ───────────────────────────
# Only needed when the monitoring stack is brought up. In prod, Grafana is
# also exposed at https://grafana.comchefs.cloud (nginx) so set a strong
# password before the DNS record flips. Locally it binds 127.0.0.1:3005 too.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                    # REQUIRED in prod — openssl rand -base64 32
GRAFANA_ROOT_URL=http://localhost:3005     # prod: https://grafana.comchefs.cloud
