# Environment files (all levels)
.env
.env.*
!.env.example

# Dependencies — catch-all for every subdir (auth-service, worker, socket-server, etc.)
node_modules/
.pnpm-store/

# Build outputs
dist/
build/

# SQL dumps — contain real user data (emails, bcrypt hashes). Never commit.
supabase-*.sql
*-backup.sql
*-data.sql
*-auth-users.sql
*.sql.gz

# Planning / internal docs — exclude every .md except README.md
*.md
!README.md
!**/README.md

# TLS certs (live on VPS only, never in git)
nginx/certs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/
